# Environment overrides for local runs (optional)
# Copy to .env if you want a personal cheat-sheet; this file is not auto-loaded by CLI
# scripts unless you export the variables. The Web UI loads .env via python-dotenv.
#
# VOXCPM_INPUT=./workspace/script.md
# VOXCPM_REFERENCE=./workspace/source.wav
# VOXCPM_OUT_ROOT=./output/voxcpm2
# VOXCPM_RUN_DIR=./output/voxcpm2/latest

# OpenRouter (LLM judge for self-improvement)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_AUDIO_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://localhost

# Docker Compose (optional; container always listens on port 7860)
# VOXCPM_WEB_PORT=7860
# VOXCPM_BIND_ADDRESS=127.0.0.1
# HF_TOKEN=
# Set VOXCPM_BIND_ADDRESS=0.0.0.0 only behind authenticated TLS/access controls.
